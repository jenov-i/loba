# ---------------------------------------------------------------------------
# LOBA - fichier de configuration
# Copie ce fichier en ".env" puis adapte les valeurs si besoin :
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Port du serveur web (https://localhost:3000)
PORT=3000

# Mettre "false" pour lancer en HTTP simple (uniquement pour tester sur localhost)
HTTPS=true

# Connexion PostgreSQL (si tu utilises docker compose, ne change rien)
DATABASE_URL=postgres://loba:loba@localhost:5432/loba

# MinIO / stockage S3 (photos, documents, messages vocaux)
# Avec docker compose : garde minioadmin / minioadmin.
# Sans Docker : lance "npm run s3" et mets S3RVER / S3RVER.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=loba

# Taille maximale d'un fichier envoyé (en Mo)
MAX_UPLOAD_MB=25

# ---------------------------------------------------------------------------
# APPELS AUDIO / VIDÉO : serveurs ICE (STUN + TURN)
#
# Sans TURN, les appels ne fonctionnent qu'entre deux appareils capables de se
# joindre directement (même réseau). Dès que les participants sont sur des
# réseaux différents (4G, NAT strict, tunnel Cloudflare), il FAUT un TURN.
# ---------------------------------------------------------------------------

# STUN : découverte de l'adresse publique (facultatif, valeurs par défaut OK)
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# --- Option 1 : coturn auto-hébergé (voir docker-compose.turn.yml) ----------
# TURN_URLS=turn:IP_PUBLIQUE:3478?transport=udp,turn:IP_PUBLIQUE:3478?transport=tcp
# TURN_SECRET=change-moi-par-un-secret-long-et-aleatoire
# TURN_TTL_SECONDS=3600

# Variante sans secret partagé (identifiants fixes, moins sûr) :
# TURN_URLS=turn:IP_PUBLIQUE:3478
# TURN_USERNAME=loba
# TURN_CREDENTIAL=motdepassefort

# --- Option 2 : Cloudflare Realtime TURN (recommandé derrière cloudflared) --
# Tableau de bord Cloudflare > Realtime > TURN Keys.
# CF_TURN_KEY_ID=
# CF_TURN_API_TOKEN=

