# ---------------------------------------------------------------------------
# LOBA - fichier de configuration
# Copie ce fichier en ".env" puis adapte les valeurs si besoin :
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Port du serveur web (https://localhost:3000)
PORT=3000

# Mettre "false" pour lancer en HTTP simple (uniquement pour tester sur localhost)
HTTPS=true

# Connexion PostgreSQL (si tu utilises docker compose, ne change rien)
DATABASE_URL=postgres://loba:loba@localhost:5432/loba

# MinIO / stockage S3 (photos, documents, messages vocaux)
# Avec docker compose : garde minioadmin / minioadmin.
# Sans Docker : lance "npm run s3" et mets S3RVER / S3RVER.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=loba

# Taille maximale d'un fichier envoyé (en Mo)
MAX_UPLOAD_MB=25
